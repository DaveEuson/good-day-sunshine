[Unit]
Description=Life Dashboard kiosk
After=graphical-session.target
Wants=graphical-session.target

[Service]
# edit: host, mode (tv|small), user
ExecStart=%h/life-dashboard/scripts/kiosk.sh http://192.168.1.10:4242 tv dave
Restart=always
RestartSec=5
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0

[Install]
WantedBy=default.target
