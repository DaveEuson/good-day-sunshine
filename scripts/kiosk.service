[Unit]
Description=Good Day Sunshine kiosk
After=graphical-session.target
Wants=graphical-session.target

[Service]
# edit: host, mode (tv|small), user
ExecStart=%h/good-day-sunshine/scripts/kiosk.sh http://192.168.1.10:4242 tv dave
Restart=always
RestartSec=5
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0

[Install]
WantedBy=default.target
