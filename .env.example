# Copy to .env. Every key optional; a widget without its keys shows a setup hint.
PORT=4242

# GitHub: falls back to `gh auth token` if unset. Scopes: repo (traffic), notifications.
GITHUB_TOKEN=

# YouTube Data API v3 key (console.cloud.google.com) + channel id (UC...).
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Twitch app (dev.twitch.tv/console). Follower count needs a user token with moderator:read:followers.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_LOGIN=
TWITCH_USER_TOKEN=

# AI brief. Local Ollama default; set OLLAMA_URL/OLLAMA_MODEL to change.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Chat assistant model (any Ollama model). Brief uses OLLAMA_MODEL above.
CHAT_MODEL=llama3.2:3b

# Calendar: private iCal URL(s), comma separated. Google: Settings → your calendar → "Secret address in iCal format".
CALENDAR_ICS=

# Gmail unread: app password (Google Account → Security → 2-Step Verification → App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=
